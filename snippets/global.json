{
  "clj-script": {
    "description": "Clojure script skeleton",
    "prefix": "clj-script",
    "body": [
      "#!/bin/sh",
      "#_(#_sh",
      "   destdir=\\$HOME/.bin",
      "   test ! -f \"\\$destdir/cream\" &&",
      "   mkdir -p \"\\$destdir\" &&",
      "   curl -sSL \"https://github.com/borkdude/cream/releases/download/dev/cream-linux-amd64.tar.gz\" | tar xz -C \"\\$destdir\"",
      "",
      "   deps='",
      "   {:deps {org.clojure/tools.logging {:mvn/version \"1.3.1\"}",
      "           org.clojure/data.json {:mvn/version \"2.5.2\"}",
      "           org.babashka/http-client {:mvn/version \"0.4.26\"}",
      "           camel-snake-kebab/camel-snake-kebab {:mvn/version \"0.4.3\"}}}",
      "   '_",
      "   exec \"\\$destdir/cream\" -Sdeps \"\\$deps\" -M -i \"\\$0\" -m ${1:${TM_FILENAME_BASE}} \"\\$@\"",
      "   #_sh)",
      "",
      "#_{:clj-kondo/ignore [:namespace-name-mismatch]}",
      "(ns $1",
      "  (:require",
      "   [clojure.string :as str]",
      "   [clojure.pprint :refer [pprint]]",
      "   [clojure.java.io :as io]",
      "   [clojure.java.shell :refer [sh]]",
      "   [clojure.java.process :as process]",
      "   [clojure.tools.logging :as log]",
      "   [clojure.data.json :as json]",
      "   [babashka.http-client :as http]",
      "   [camel-snake-kebab.core :as csk])",
      "  (:gen-class))",
      "",
      "(defn -main [& args]",
      "  (println \"hello there\"))",
      "",
      "; vim: ft=clojure"
    ]
  }
}
