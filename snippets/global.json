{
  "clj-script": {
    "description": "Clojure script skeleton",
    "prefix": "clj-script",
    "body": [
      "#!/bin/sh",
      "#_(#_sh",
      "   destdir=\\$HOME/.bin",
      "   test ! -f \"\\$destdir/cream\" &&",
      "   mkdir -p \"\\$destdir\" &&",
      "   curl -sSL \"https://github.com/borkdude/cream/releases/download/dev/cream-linux-amd64.tar.gz\" | tar xz -C \"\\$destdir\"",
      "",
      "   deps='",
      "   {:deps {org.clojure/tools.logging {:mvn/version \"1.3.1\"}",
      "           clj-http/clj-http {:mvn/version \"3.13.1\"}}}",
      "   '_",
      "   exec \"\\$destdir/cream\" -Sdeps \"\\$deps\" -M -i \"\\$0\" -m ${1:${TM_FILENAME_BASE}} \"\\$@\"",
      "   #_sh)",
      "",
      "#_{:clj-kondo/ignore [:namespace-name-mismatch]}",
      "(ns $1",
      "  (:require",
      "   [clojure.tools.logging :as log]",
      "   [clj-http.client :as http])",
      "  (:gen-class))",
      "",
      "(defn -main [& args]",
      "  (println \"hello there\"))",
      "",
      "; vim: ft=clojure"
    ]
  }
}
